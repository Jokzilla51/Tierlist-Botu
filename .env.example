# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=your_bot_token

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=your_application_id

# Botun ve komutların kullanılacağı Discord sunucusunun ID'si (zorunlu).
GUILD_ID=your_discord_server_id

# Yerel kopya; bot ayrıca tester panelinde otomatik Discord yedeği tutar.
# Render Persistent Disk kullanıyorsanız /var/data/state.json yapabilirsiniz.
DATA_FILE=./data/state.json

# true yapmadan önce Developer Portal > Bot > Presence Intent'i açın.
ENABLE_PRESENCE_INTENT=false
# Hazır onayı için 1-60 dakika arası değer kullanın.
READY_TIMEOUT_MINUTES=5
# No-show tekrar çağrısı için 1-1440 dakika arası değer kullanın.
NO_SHOW_RETRY_MINUTES=15

