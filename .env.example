# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=your_bot_token

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=your_application_id

# Komutları hızlıca sadece bu sunucuya kaydetmek için Discord sunucu ID'si.
# Boş bırakırsanız komutlar global kaydedilir (yayılması zaman alabilir).
GUILD_ID=your_discord_server_id

# Kalıcı disk olmadan Render yeniden başlatıldığında kuyruk verileri sıfırlanır.
# Render Persistent Disk bağlarsanız bunu /opt/render/project/src/data/state.json yapın.
DATA_FILE=./data/state.json

